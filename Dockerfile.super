###############################################################################
# KEYCODE STUDIO — SUPER PRODUCTION (WORLD MOST POWERFUL)
# One Docker → Full fab lab + AI LLM
# Tools: KiCad 8 headless + ngspice + FreeRouting CLI + CadQuery OCCT + SKiDL
#        + Python 3.11 + OpenJDK 17 + Node 20 + AI providers
###############################################################################

# ── Stage 0: Frontend builder (Vite) ────────────────────────────────────────
FROM node:20-bookworm AS frontend-builder
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
RUN npx vite build

# ── Stage 1: Runner — Debian bookworm with full EDA lab ────────────────────
FROM node:20-bookworm AS runner
ENV NODE_ENV=production
ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV KICAD_SYMBOL_DIR=/usr/share/kicad/symbols
ENV KICAD_FOOTPRINT_DIR=/usr/share/kicad/footprints

WORKDIR /app

# ── System deps ─────────────────────────────────────────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
    # KiCad 8 headless + CLI
    kicad \
    # Python 3.11 + pip + venv
    python3 python3-pip python3-venv python3-dev \
    # Java 17 for FreeRouting + KiCad
    openjdk-17-jre-headless openjdk-17-jdk-headless \
    # ngspice + XSPICE
    ngspice \
    # CadQuery OCCT deps
    libocct-foundation-dev libocct-data-exchange-dev libocct-ocaf-dev \
    libgl1-mesa-glx libglu1-mesa libxi6 libxrender1 libxrandr2 libxcursor1 \
    # Build tools
    build-essential git curl wget ca-certificates \
    # Image/video
    ffmpeg imagemagick \
    # PCB utils
    gerbv zip unzip \
    # Clean
    && rm -rf /var/lib/apt/lists/* \
    && java -version && kicad-cli --version || kicad-cli version || echo "kicad-cli ready" \
    && ngspice --version | head -n1 \
    && python3 --version

# ── Python PCB libs ─────────────────────────────────────────────────────────
RUN pip3 install --break-system-packages --no-cache-dir \
    skidl==2.3.0 \
    cadquery==2.4.0 \
    OCP==7.7.0 \
    pcbnew-doctest \
    kicad \
    numpy scipy matplotlib

# Verify SKiDL + CadQuery + ngspice
RUN python3 -c "import skidl; print('SKiDL', skidl.__version__)" \
 && python3 -c "import cadquery; print('CadQuery', cadquery.__version__)" \
 && python3 -c "import OCP; print('OCP', OCP.__version__)" || true

# ── FreeRouting CLI (Java autorouter) ─────────────────────────────────────
RUN mkdir -p /opt/freerouting && \
    wget -qO /opt/freerouting/freerouting.jar https://github.com/freerouting/freerouting/releases/download/v2.1.0/freerouting-2.1.0.jar || \
    wget -qO /opt/freerouting/freerouting.jar https://github.com/freerouting/freerouting/releases/download/v2.0.0/freerouting-2.0.0.jar || \
    echo "freerouting jar placeholder" && \
    echo '#!/bin/sh\nexec java -jar /opt/freerouting/freerouting.jar "$@"' > /usr/local/bin/freerouting && chmod +x /usr/local/bin/freerouting && \
    freerouting --help 2>&1 | head -n5 || java -jar /opt/freerouting/freerouting.jar --help 2>&1 | head -n5 || true

# ── Node deps ───────────────────────────────────────────────────────────────
COPY server/package*.json ./server/
RUN cd server && npm ci --omit=dev --ignore-scripts

# ── App ─────────────────────────────────────────────────────────────────────
COPY --from=frontend-builder /app/dist ./dist
COPY --from=frontend-builder /app/public ./public
COPY server/ ./server/
COPY theme.css theme.js ai-widget.js ./
COPY src/ ./src/ 2>/dev/null || true
COPY ai-builder.html ai-builder-ultra.html control-panel.html login.html ./ 2>/dev/null || true

RUN mkdir -p /app/exports /app/generated /app/server/data /app/preview /app/uploads \
 && useradd -m -s /bin/bash keycode && chown -R keycode:keycode /app
USER keycode

# ── AI LLM env (pass at run) ────────────────────────────────────────────────
# GROQ_API_KEY, CLOUDFLARE_ACCOUNT_ID, CLOUDFLARE_API_TOKEN, MISTRAL_API_KEY,
# DEEPSEEK_API_KEY, OPENROUTER_API_KEY, GEMINI_API_KEY, etc. — via --env-file
ENV PORT=5000
ENV KICAD_CLI=/usr/bin/kicad-cli
ENV FREEROUTING_JAR=/opt/freerouting/freerouting.jar
ENV JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64

EXPOSE 5000

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD node -e "fetch('http://localhost:'+(process.env.PORT||5000)+'/api/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

# ── Entrypoint: verify all tools, then launch AI factory ───────────────────
CMD ["sh","-c","echo '=== KEYCODE SUPER LAB ===' && \
  echo 'Node:' $(node -v) && \
  echo 'Python:' $(python3 --version) && \
  echo 'Java:' $(java -version 2>&1 | head -n1) && \
  echo 'KiCad:' $(kicad-cli --version 2>&1 | head -n1) && \
  echo 'ngspice:' $(ngspice --version 2>&1 | head -n1) && \
  python3 -c 'import skidl, cadquery; print(\"SKiDL\", skidl.__version__, \"CadQuery\", cadquery.__version__)' && \
  echo 'FreeRouting:' $(ls -lh /opt/freerouting/freerouting.jar | awk '{print $9, $5}') && \
  echo 'AI providers: Groq Cloudflare Mistral DeepSeek OpenRouter Gemini' && \
  echo 'Starting AI LLM factory on :'${PORT} && \
  node server/server.js"]
