# ============================================================
#  KEYCODE Studio — Backend .env
#  Copy this file to .env and fill in the real values.
#  The server runs in "mock" mode when Supabase / Stripe
#  variables are absent, so you can start it immediately and
#  wire real credentials later.
# ============================================================

# ---- Server ----
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# ---- Regional price list ----
# lib/pricing-regions.json is the single source of truth for what anything costs
# in each region. It holds two maps per group:
#   "prices"        subscription plans, e.g. { "starter": 19 }
#   "websiteOrders" one-off project services sold on /checkout.html, whose slugs
#                   are listed in lib/website-orders.js — e.g. 12999 for an INR
#                   "professional-website"
# The price a page displays, the amount Stripe / the UPI QR is asked to charge,
# and the total stored on the order all come from that one file, so they cannot
# drift apart. Amounts are stated in each group's own currency (no
# exchange-rate math), and editing it needs no code change or server restart.
# Add a group with its own "countries" list to price that region; "default"
# covers everyone else. A websiteOrder slug missing from a group makes that
# service unavailable there rather than charging another currency's number.
#
# Coupons (data/mock-coupons.json, or the Supabase "coupons" table) are stated
# in USD and are therefore only accepted on USD orders.

# ---- Session tokens (JWT) ----
# Used to sign the session tokens handed to the browser.
# In production this MUST be a long random string kept secret.
JWT_SECRET=your-secret-here-change-in-production
JWT_EXPIRY=7d

# ---- Supabase ----
# Leave these unset to run in fully-local mock mode.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-key

# ---- Stripe (card payments) ----
# Card checkout stays OFF until a real key is present: a placeholder value such
# as sk_test_... is detected and ignored rather than used, so a bad key can never
# fail every charge. Check /api/health - it reports "stripe":"configured" once
# a real key is in place.
STRIPE_SECRET_KEY=
# Signing secret of the Stripe webhook endpoint that points at
# POST /api/webhooks/stripe. Required for plan activations and renewals: without
# it a forged payload could grant a paid plan for free.
STRIPE_WEBHOOK_SECRET=

# ---- UPI (INR payments) ----
# Set this to YOUR OWN UPI ID, exactly as it appears in your bank / UPI app,
# e.g. yourname@okhdfcbank or 9876543210@ybl. Leave it empty to hide the UPI
# rail entirely. A placeholder value is refused, because a QR that names someone
# else's account would send your customers' money to them, not to you.
# UPI is offered only when the visitor's region is priced in INR
# (see lib/pricing-regions.json).
UPI_ID=
# Fill your VPA above, then check it loaded: GET /api/payment/config should
# return methods.upi.available = true for INR-priced visitors (India).
# Until then the UPI QR rail stays hidden and the site only offers card
# (which itself needs STRIPE_SECRET_KEY, an 18+ parent-managed account).
# ---- Social OAuth (optional) ----
# When configured, /api/auth/<provider> kicks off the OAuth flow.
# Register each callback URL as an authorized redirect URI with its provider.
# For a local Google OAuth setup, register:
# http://localhost:3000/api/auth/google/callback
# Use the public HTTPS URL instead when deploying the site.
# Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# GitHub
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3000/api/auth/github/callback

# Discord
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_CALLBACK_URL=http://localhost:3000/api/auth/discord/callback

# ---- Social publishing (optional; Meta Graph API) ----
# Use a Meta app with the approved Page/Instagram publishing permissions.
# Instagram account must be a connected Business or Creator account.
# Keep tokens server-side; never put these values in browser code.
META_ACCESS_TOKEN=
META_INSTAGRAM_ACCOUNT_ID=
META_FACEBOOK_PAGE_ID=
META_GRAPH_API_VERSION=v23.0

# ---- CORS ----
# Comma-separated list of origins that may call the API.
ALLOWED_ORIGINS=http://localhost:3000,https://keycode.studio

# --- AI provider (optional; empty = local engine fallback) ---
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=
AI_TIMEOUT_MS=45000

# --- Agent: GitHub integration (optional) ---
# Personal access token with "repo" scope: https://github.com/settings/tokens
GITHUB_TOKEN=

# --- Agent concurrency (users are queued fairly, not rejected) ---
AGENT_MAX_CONCURRENT=6
AGENT_MAX_PER_USER=2
AGENT_QUEUE_LIMIT=100

# --- LLM key pool (optional; enables unlimited-feel AI for users) ---
# Semicolon-separated keys; round-robin with auto-cooldown on rate limits.
# Format: provider|key|baseUrl|model  (baseUrl/model optional per entry)
# Example with 2 free Groq keys + 1 paid OpenAI fallback:
# AI_POOL=openai-compatible|gsk_key1|https://api.groq.com/openai/v1|llama-3.3-70b-versatile;openai-compatible|gsk_key2|https://api.groq.com/openai/v1|llama-3.3-70b-versatile;openai|sk-...||gpt-4o-mini
AI_POOL=
