# API Keys & Credentials
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/keycode
OPENAI_API_KEY=sk_test_your_key
GROQ_API_KEY=gsk_your_key
ANTHROPIC_API_KEY=sk-ant-your_key
OPENCODE_API_KEY=your_key

# Stripe Keys
STRIPE_SECRET_KEY=sk_test_your_key
STRIPE_PUBLIC_KEY=pk_test_your_key

# JWT & Security
JWT_SECRET=your_secret_key_min_32_chars

# Email Configuration
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password

# Environment
NODE_ENV=production
PORT=5000
FRONTEND_URL=https://keycode.vercel.app

# AI Services
USE_GROQ=true
USE_ANTHROPIC=false
USE_OPENAI=true

# Azure AI Foundry (successor to retired GitHub Models — OpenAI-compatible)
# Get a key at azure.microsoft.com → AI Foundry; a GitHub PAT also works while
# migration access lasts. Model IDs use publisher/model format.
AZURE_FOUNDRY_API_KEY=your_azure_foundry_key
AZURE_FOUNDRY_ENDPOINT=https://models.github.ai/inference
AZURE_FOUNDRY_MODELS=openai/gpt-4.1-mini,openai/gpt-4o-mini,microsoft/Phi-4,deepseek/DeepSeek-V3-0324

# Ollama (free, private, local models)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# ============ AGENT ROUTER — 9 providers ============
# Dify (self-hosted workflow/chatflow app)
DIFY_HOST=http://localhost:80
DIFY_API_KEY=app-your_dify_app_key

# Langflow (self-hosted flow)
LANGFLOW_HOST=http://localhost:7860
LANGFLOW_FLOW_ID=your_flow_uuid
LANGFLOW_API_KEY=

# Open Interpreter (local agentic CLI — npm i -g open-interpreter or pip)
INTERPRETER_BIN=interpreter
INTERPRETER_MODEL=

# Remaining swarm members (keys optional — configured routers only are used)
# groq · mistral · deepseek · openrouter · azure-foundry · ollama
# are picked up from the AI Services keys above.

# ============ AGENT RUNTIME — ReAct / sandbox / MCP fleet ============
# Filesystem + git connector roots (sandboxed; defaults: repo root)
AGENT_FS_ROOT=
AGENT_GIT_ROOT=

# Live information (Brave Search MCP)
BRAVE_API_KEY=

# Database connectors (postgres queries are read-only enforced)
POSTGRES_URL=
REDIS_URL=

# Enterprise comms (Slack MCP + Atlassian Jira/Confluence MCP)
SLACK_BOT_TOKEN=
SLACK_TEAM_ID=
ATLASSIAN_HOST=https://your-company.atlassian.net
ATLASSIAN_EMAIL=you@company.com
ATLASSIAN_API_TOKEN=
