# KEYCODE - Free Environment Configuration
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000

# MongoDB (local - free)
MONGODB_URI=mongodb://127.0.0.1:27017/keycode

# JWT (change this random string for production)
JWT_SECRET=kc_free_secret_2024_change_in_production
JWT_EXPIRES=7d

# ===== FREE AI SERVICES =====

# 1. Hugging Face - FREE Code Generation
# Get free token: https://huggingface.co/settings/tokens
HF_TOKEN=your_huggingface_token_here

# 2. Groq - FREE (already has key)
GROQ_API_KEY=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

# 3. Ollama - Run locally (FREE)
# Download: https://ollama.com
OLLAMA_URL=http://localhost:11434

# ===== FREE PAYMENT =====
# Using manual payment (bank transfer / manual)
PAYMENT_MODE=manual

# ===== FREE EMAIL ===== 
# Using Gmail SMTP (your personal account)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_app_password

# ===== FREE HOSTING/DOMAIN =====
# Users get free subdomain: yourname.keycode.studio
