  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "start:production": "NODE_ENV=production node server.js",
    "start:admin": "node admin-server.js",
    "start:all": "node server.js & sleep 3 && node admin-server.js",
