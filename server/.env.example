# Environment Configuration
NODE_ENV=production
PORT=5000

# Frontend URL (MUST BE SET FOR PRODUCTION)
FRONTEND_URL=https://yourdomain.com

# MongoDB Connection
MONGODB_URI=mongodb://username:password@cluster.mongodb.net/keycode

# JWT Secret (REQUIRED - generate with: openssl rand -hex 64)
JWT_SECRET=GENERATE_A_SECURE_SECRET_HERE
JWT_EXPIRES=7d

# PII Encryption Key (REQUIRED - generate with: openssl rand -hex 32)
ENCRYPTION_KEY=GENERATE_A_32_BYTE_HEX_KEY

# Payment: Razorpay (India - optional)
RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=your_razorpay_secret
UPI_ID=your-upi@upi

# AI Providers (at least one required)
DEEPSEEK_API_KEY=sk-your-deepseek-key
GROQ_API_KEY=gsk_your-groq-key
HF_TOKEN=hf_your-huggingface-token
MISTRAL_API_KEY=your-mistral-key
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token

# Email (SMTP - optional, for notifications)
# Gmail: Use App Password (https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# OAuth (optional)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_CALLBACK_URL=http://localhost:5000/api/auth/github/callback
DISCORD_CLIENT_ID=your-discord-client-id
DISCORD_CLIENT_SECRET=your-discord-client-secret
DISCORD_CALLBACK_URL=http://localhost:5000/api/auth/discord/callback

# Admin Credentials (REQUIRED - change these!)
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=CHANGE_THIS_PASSWORD
ADMIN_IP_WHITELIST=127.0.0.1,::1
ADMIN_BASIC_USER=admin
ADMIN_BASIC_PASS=CHANGE_THIS_BASIC_AUTH_PASS

# Company
COMPANY_NAME=KEYCODE
COMPANY_LOGO_URL=/logo.png
FREE_SUBDOMAIN_ENABLED=true

# Rate Limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100

# AI Model Limits
AI_RATE_LIMIT_PER_USER=50
AI_RATE_LIMIT_WINDOW_MS=3600000

# Stripe (optional)
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Turnstile CAPTCHA (optional)
TURNSTILE_SITE_KEY=your_turnstile_site_key
TURNSTILE_SECRET_KEY=your_turnstile_secret_key

# R2 Object Storage (optional, for file backups)
R2_ENDPOINT=https://your-account.r2.cloudflarestorage.com
R2_ACCESS_KEY=your-r2-access-key
R2_SECRET_KEY=your-r2-secret-key
R2_BUCKET=keycode-backups

# Additional AI Providers (optional)
QWEN_API_KEY=your-qwen-api-key
GEMINI_API_KEY=your-gemini-api-key
DEEPINFRA_API_KEY=your-deepinfra-api-key
