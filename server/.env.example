# Environment Configuration
NODE_ENV=production
PORT=5000

# Frontend URL (MUST BE SET FOR PRODUCTION)
FRONTEND_URL=https://yourdomain.com

# MongoDB Connection (use MongoDB Atlas or local for production)
MONGODB_URI=mongodb://username:password@cluster.mongodb.net/keycode

# JWT Secret (REQUIRED - generate with: openssl rand -hex 64)
JWT_SECRET=GENERATE_A_SECURE_SECRET_HERE
JWT_EXPIRES=7d

# Groq AI API Key (get from https://console.groq.com)
GROQ_API_KEY=your-groq-api-key

# Stripe Payment Integration (get from https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# SMTP Email Configuration (for notifications)
# Gmail: Use App Password (https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Admin Credentials (REQUIRED - change these!)
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=CHANGE_THIS_PASSWORD

# Rate Limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100
